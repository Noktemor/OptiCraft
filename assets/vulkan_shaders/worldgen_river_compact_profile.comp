#version 450
layout(local_size_x=64) in;
struct Profile {int river,top,water,bed,fall,lake;};
layout(std430,binding=5) readonly buffer Resolved {ivec4 resolved[];};
layout(std430,binding=6) writeonly buffer Profiles {Profile profiles[];};
void main(){
 uint i=gl_GlobalInvocationID.x;if(i>=65536u)return;
 int x=int(i%256u)+4,z=int(i/256u)+4;
 ivec4 c=resolved[z*264+x];
 Profile p=Profile(0,c.x,0,0,(-2147483647-1),0);
 if(c.y!=0||c.w!=0){
   p.river=1;p.lake=c.w;p.water=c.z;p.bed=min(p.top,p.water)-2;
   if(p.lake==0){
     int lowest=p.water;
     for(int dz=-4;dz<=4;++dz)for(int dx=-4;dx<=4;++dx){ivec4 n=resolved[(z+dz)*264+x+dx];if(n.y!=0)lowest=min(lowest,n.z);}
     if(p.water-lowest>=3){p.fall=lowest;p.bed=lowest-2;}
   }
 }
 profiles[i]=p;
}
