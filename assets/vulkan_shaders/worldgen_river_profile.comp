#version 450
layout(local_size_x=64) in;
struct Cell { int area,lake,lake_level; };
struct Profile { int river,top,water,bed,fall,lake; };
layout(std430,binding=1) readonly buffer Height { int height[]; };
layout(std430,binding=4) readonly buffer Graph { Cell graph[]; };
layout(std430,binding=5) readonly buffer River { ivec2 river[]; };
layout(std430,binding=6) writeonly buffer Profiles { Profile profiles[]; };
void main(){
 uint i=gl_GlobalInvocationID.x;if(i>=65536u)return;
 int x=int(i%256u)+256,z=int(i/256u)+256,j=z*768+x;
 Profile p=Profile(0,height[j],0,0,(-2147483647-1),0);
 if(river[j].x!=0||graph[j].lake!=0){
   p.river=1;p.lake=graph[j].lake;p.water=river[j].y;p.bed=min(p.top,p.water)-2;
   if(p.lake==0){
     int lowest=p.water;
     for(int dz=-4;dz<=4;++dz)for(int dx=-4;dx<=4;++dx){ivec2 n=river[(z+dz)*768+x+dx];if(n.x!=0)lowest=min(lowest,n.y);}
     if(p.water-lowest>=3){p.fall=lowest;p.bed=lowest-2;}
   }
 }
 profiles[i]=p;
}
