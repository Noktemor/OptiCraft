#version 450
// Existing material shader bindings 4/5, populated from Stage94-97 layers.
layout(local_size_x=64) in;
struct Layer {double height;uint biome,packed_layers;};
struct Column {double surface_height;uint biome,pad;};
layout(std430,binding=0) readonly buffer Layers {Layer layers[];};
layout(std430,binding=1) writeonly buffer Columns {Column columns[];};
layout(std430,binding=2) writeonly buffer Material {uint words[];};
layout(push_constant) uniform Params {uint count,flags;int sea;uint water_floor;int ys[9];};
void main(){
 uint i=gl_GlobalInvocationID.x;
 if(i>=1024u||count==0u||count>9u||(flags!=1u&&flags!=3u))return;
 Layer l=layers[i];columns[i]=Column(l.height,l.biome,flags);
 if(i==0u){for(uint j=0u;j<9u;++j)words[j]=j<count?uint(ys[j]):0u;
  words[9]=uint(sea);words[10]=water_floor;}
 uint p=11u+4u*i;
 // Disabled river profile is identical to Gpu_Base_Region::profile(false,0,0,0,...).
 words[p]=2147483647u;words[p+1u]=0u;words[p+2u]=0u;words[p+3u]=l.packed_layers;
 // Every active cave word is cleared, even when a scratch allocation is reused.
 // Each invocation owns exactly two words per level; no atomics or overlap.
 for(uint j=0u;j<count;++j){uint k=4107u+j*2048u+2u*i;words[k]=0u;words[k+1u]=0u;}
}
