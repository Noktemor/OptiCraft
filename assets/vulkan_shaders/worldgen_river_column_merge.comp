#version 450
layout(local_size_x=64) in;
struct Profile {int river,top,water,bed,fall,lake;};
layout(std430,binding=0) readonly buffer Resolved {ivec4 resolved[];};
layout(std430,binding=1) readonly buffer Reference {uint referenceWords[];};
layout(std430,binding=2) buffer Material {uint words[];};
layout(std430,binding=3) buffer Stats {uint accepted;};
layout(push_constant) uniform Params {int sea;};
void main(){
 uint i=gl_GlobalInvocationID.x;if(i>=1024u)return;
 int x=int(i%32u)+4,z=int(i/32u)+4;
 ivec4 c=resolved[z*40+x];
 Profile p=Profile(0,c.x,0,0,(-2147483647-1),0);
 if(c.y!=0||c.w!=0){
   p.river=1;p.lake=c.w;p.water=c.z;p.bed=min(p.top,p.water)-2;
   if(p.lake==0){
     int lowest=p.water;
     for(int dz=-4;dz<=4;++dz)for(int dx=-4;dx<=4;++dx){ivec4 n=resolved[(z+dz)*40+x+dx];if(n.y!=0)lowest=min(lowest,n.z);}
     if(p.water-lowest>=3){p.fall=lowest;p.bed=lowest-2;}
   }
 }
 // The reference remains authoritative until native hydrology is validated.
 uint j=11u+i*4u;
 uvec3 candidate=uvec3(p.river!=0?uint(p.bed):2147483647u,uint(p.water),uint(p.top));
 if(referenceWords[9]!=uint(sea))return;
 if(all(equal(candidate,uvec3(referenceWords[j],referenceWords[j+1u],referenceWords[j+2u])))){
   words[j]=candidate.x;words[j+1u]=candidate.y;words[j+2u]=candidate.z;
   atomicAdd(accepted,1u);
 }
}
