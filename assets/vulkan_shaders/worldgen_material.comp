#version 450
// OpenSimplex2S 3D (XZ-before-Y), ported from the project's C implementation.
// FP64 is deliberate: worldgen must not silently change saved worlds.
// Output = 0 for voxels that must be generated by the authoritative CPU path.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer Permutations { int permutation[2048]; };
layout(std430, binding = 1) readonly buffer Gradients { dvec4 gradients[2048]; };
struct LatticeNode { dvec4 delta; ivec4 offsets; ivec4 next; };
layout(std430, binding = 2) readonly buffer Lattices { LatticeNode nodes[]; };
layout(std430, binding = 3) readonly buffer Octants { int starts[8]; };
struct Column { double surface_height; uint biome; uint pad; };
layout(std430, binding = 4) readonly buffer Columns { Column columns[1024]; };
layout(std430, binding = 5) readonly buffer Levels { int chunk_y[]; };
layout(std430, binding = 6) writeonly buffer Materials { uint materials[]; };

layout(push_constant, std430) uniform Params {
    int uChunkX; int uChunkZ; int uChunkCount; int uWorldMinY; int uWorldMaxY;
    uint uBlocks[10];
};

// The table contains exactly the paths of the original branching BCC lookup.
double open_simplex3(dvec3 p) {
    double xz = p.x + p.z;
    double s2 = xz * -0.211324865405187;
    double yy = p.y * 0.577350269189626;
    dvec3 r = dvec3(p.x + s2 - yy,
                     xz * 0.577350269189626 + yy,
                     p.z + s2 - yy);
    ivec3 base = ivec3(floor(r));
    dvec3 relative = r - dvec3(base);
    ivec3 oct = ivec3(relative + dvec3(0.5));
    int node_index = starts[oct.x | (oct.y << 1) | (oct.z << 2)];
    double value = 0.0;
    // Defensive limit protects against corrupt GPU tables without a driver hang.
    for (int n = 0; n < 24 && node_index >= 0; ++n) {
        LatticeNode node = nodes[node_index];
        dvec3 d = relative + node.delta.xyz;
        double attn = 0.75 - d.x*d.x - d.y*d.y - d.z*d.z;
        if (attn < 0.0) {
            node_index = node.next.x;
        } else {
            ivec3 pos = (base + node.offsets.xyz) & 2047;
            // permGrad3[] is already permuted by perm[], so there is no third lookup.
            int gindex = permutation[permutation[pos.x] ^ pos.y] ^ pos.z;
            dvec3 grad = gradients[gindex].xyz;
            double extrapolation = grad.x*d.x + grad.y*d.y + grad.z*d.z;
            attn *= attn;
            value += attn * attn * extrapolation;
            node_index = node.next.y;
        }
    }
    return value;
}

double normalized_noise(dvec3 p) {
    return clamp(open_simplex3(p) * 0.5 + 0.5, 0.0, 1.0);
}
bool uncertain(double value, double threshold) {
    // Differences from FMA / compiler contraction near a boundary must fall back to CPU.
    return abs(value - threshold) < 0.000001;
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    uint n = 32u * 32u * 32u;
    uint total = n * uint(uChunkCount);
    if (index >= total) return;
    uint voxel = index % n;
    uint ci = index / n;
    uint x = voxel % 32u;
    uint z = (voxel / 32u) % 32u;
    uint y = voxel / (32u * 32u);
    uint c = z * 32u + x;
    int wy = chunk_y[ci] * 32 + int(y);
    Column column = columns[c];
    double below = column.surface_height - double(wy);
    uint id = 0u;
    if (wy >= uWorldMinY && wy <= uWorldMaxY &&
        wy < int(floor(column.surface_height)) && below > 4.0) {
        int wx = uChunkX * 32 + int(x);
        int wz = uChunkZ * 32 + int(z);
        double ore = normalized_noise(dvec3(double(wx) * 0.11,
                                            double(wy) * 0.11,
                                            double(wz) * 0.11));
        bool uncertain_result = uncertain(ore, 0.84) || uncertain(ore, 0.76) ||
                                uncertain(ore, 0.915) || uncertain(ore, 0.86) ||
                                uncertain(ore, 0.74) || uncertain(ore, 0.82) ||
                                uncertain(ore, 0.70);
        if (below >= 250.0) {
            id = ore > 0.84 ? uBlocks[2] : (ore > 0.76 ? uBlocks[3] : uBlocks[1]);
        } else if (below >= 90.0 && ore > 0.915) {
            id = uBlocks[3];
        } else if (below >= 90.0 && ore > 0.86) {
            id = uBlocks[4];
        } else {
            // Match the C++ lazy order so that ore-laden regions do not evaluate
            // 4 expensive FP64 noises for every single solid voxel.
            double copper = normalized_noise(dvec3(double(wx)*0.13+31.7, double(wy)*0.13-4.2, double(wz)*0.13+9.9));
            uncertain_result = uncertain_result || uncertain(copper, 0.86);
            if (copper > 0.86) {
                id = uBlocks[5];
            } else if (below >= 90.0) {
                double lapis = normalized_noise(dvec3(double(wx)*0.13+43.1, double(wy)*0.13-12.3, double(wz)*0.13+7.4));
                uncertain_result = uncertain_result || uncertain(lapis, 0.88);
                if (lapis > 0.88) {
                    id = uBlocks[6];
                } else {
                    double coal = normalized_noise(dvec3(double(wx)*0.13-17.3, double(wy)*0.13+12.6, double(wz)*0.13+5.1));
                    uncertain_result = uncertain_result || uncertain(coal, 0.80);
                    id = coal > 0.80 ? uBlocks[7] : ore > 0.74 ? uBlocks[8] : uBlocks[0];
                }
            } else {
                double coal = normalized_noise(dvec3(double(wx)*0.13-17.3, double(wy)*0.13+12.6, double(wz)*0.13+5.1));
                uncertain_result = uncertain_result || uncertain(coal, 0.80);
                if (coal > 0.80) id = uBlocks[7];
                else {
                    double lapis = normalized_noise(dvec3(double(wx)*0.13+43.1, double(wy)*0.13-12.3, double(wz)*0.13+7.4));
                    uncertain_result = uncertain_result || uncertain(lapis, 0.92);
                    id = lapis > 0.92 ? uBlocks[6] : ore > 0.82 ? uBlocks[8] :
                         (ore > 0.70 && column.biome == 4u) ? uBlocks[9] : uBlocks[0];
                }
            }
        }
        if (uncertain_result) id = 0u;
    }
    materials[index] = id;
}
