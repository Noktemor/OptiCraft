#version 450
// OpenSimplex2S 3D (XZ-before-Y), ported from the project's C implementation.
// FP64 is deliberate: worldgen must not silently change saved worlds.
// Output packs two consecutive 16-bit material IDs per uint, as in voxel storage.
// Legacy material mode: zero requests CPU fallback. Base mode: zero is air, 0xffff is fallback.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer Permutations { int permutation[2048]; };
layout(std430, binding = 1) readonly buffer Gradients { dvec4 gradients[2048]; };
struct LatticeNode { dvec4 delta; ivec4 offsets; ivec4 next; };
layout(std430, binding = 2) readonly buffer Lattices { LatticeNode nodes[]; };
layout(std430, binding = 3) readonly buffer Octants { int starts[8]; };
struct Column { double surface_height; uint biome; uint pad; };
layout(std430, binding = 4) readonly buffer Columns { Column columns[1024]; };
layout(std430, binding = 5) readonly buffer Levels { int chunk_y[]; };
layout(std430, binding = 6) buffer Materials { uint materials[]; };

layout(push_constant, std430) uniform Params {
    int uChunkX; int uChunkZ; int uChunkCount; int uWorldMinY; int uWorldMaxY;
    uint uBlocks[10];
    uint uCertify;
};

// The table contains exactly the paths of the original branching BCC lookup.
double open_simplex3(dvec3 p) {
    double xz = p.x + p.z;
    double s2 = xz * -0.211324865405187lf;
    double yy = p.y * 0.577350269189626lf;
    dvec3 r = dvec3(p.x + s2 - yy,
                     xz * 0.577350269189626lf + yy,
                     p.z + s2 - yy);
    ivec3 base = ivec3(floor(r));
    dvec3 relative = r - dvec3(base);
    ivec3 oct = ivec3(relative + dvec3(0.5lf));
    int node_index = starts[oct.x | (oct.y << 1) | (oct.z << 2)];
    double value = 0.0lf;
    // Defensive limit protects against corrupt GPU tables without a driver hang.
    for (int n = 0; n < 24 && node_index >= 0; ++n) {
        LatticeNode node = nodes[node_index];
        dvec3 d = relative + node.delta.xyz;
        double attn = 0.75lf - d.x*d.x - d.y*d.y - d.z*d.z;
        if (attn < 0.0lf) {
            node_index = node.next.x;
        } else {
            ivec3 pos = (base + node.offsets.xyz) & 2047;
            // permGrad3[] is already permuted by perm[], so there is no third lookup.
            int gindex = permutation[permutation[pos.x] ^ pos.y] ^ pos.z;
            dvec3 grad = gradients[gindex].xyz;
            double extrapolation = grad.x*d.x + grad.y*d.y + grad.z*d.z;
            attn *= attn;
            value += attn * attn * extrapolation;
            node_index = node.next.y;
        }
    }
    return value;
}

double normalized_noise(dvec3 p) {
    return clamp(open_simplex3(p) * 0.5lf + 0.5lf, 0.0lf, 1.0lf);
}
bool uncertain(double value, double threshold) {
    // Differences from FMA / compiler contraction near a boundary must fall back to CPU.
    return abs(value - threshold) < 0.000001lf;
}

uint materialAt(uint index) {
    uint n = 32u * 32u * 32u;
    uint voxel = index % n;
    uint ci = index / n;
    uint x = voxel % 32u;
    uint z = (voxel / 32u) % 32u;
    uint y = voxel / (32u * 32u);
    uint c = z * 32u + x;
    int wy = chunk_y[ci] * 32 + int(y);
    Column column = columns[c];
    double below = column.surface_height - double(wy);
    // Binding 5 reserves nine Y indices, then sea/water, 1024 four-word
    // column profiles, followed by two-bit cave masks in dispatched Y order.
    bool baseMode = (column.pad & 1u) != 0u;
    if (baseMode) {
        const uint air = 0u;
        if (wy < uWorldMinY || wy > uWorldMaxY) return air;
        uint waterAndFloor = uint(chunk_y[10]);
        if (wy == uWorldMinY && (waterAndFloor >> 16u) != 0u)
            return waterAndFloor >> 16u;
        if ((column.pad & 2u) != 0u && wy >= 200) return 0xffffu;
        int sea = chunk_y[9];
        uint water = waterAndFloor & 0xffffu;
        int height = int(floor(column.surface_height));
        if (wy > height) return wy <= sea ? water : air;
        uint p = 11u + c * 4u;
        if (wy > chunk_y[p]) {
            if (wy <= chunk_y[p+1u]) return water;
            if (wy <= chunk_y[p+2u]) return air;
        }
        uint caveWord = uint(chunk_y[4107u + ci * 2048u + voxel / 16u]);
        uint cave = (caveWord >> ((voxel & 15u) * 2u)) & 3u;
        if (cave == 1u) return air;
        if (cave == 2u) return water;
        if (cave == 3u) return 0xffffu;
        uint layers = uint(chunk_y[p+3u]);
        if (wy == height) return layers & 0xffffu;
        if (below <= 4.0lf) return layers >> 16u;
    }
    uint id = 0u;
    if (wy >= uWorldMinY && wy <= uWorldMaxY &&
        wy < int(floor(column.surface_height)) && below > 4.0lf) {
        int wx = uChunkX * 32 + int(x);
        int wz = uChunkZ * 32 + int(z);
        double ore = normalized_noise(dvec3(double(wx) * 0.11lf,
                                            double(wy) * 0.11lf,
                                            double(wz) * 0.11lf));
        bool uncertain_result = uncertain(ore, 0.84lf) || uncertain(ore, 0.76lf) ||
                                uncertain(ore, 0.915lf) || uncertain(ore, 0.86lf) ||
                                uncertain(ore, 0.74lf) || uncertain(ore, 0.82lf) ||
                                uncertain(ore, 0.70lf);
        if (below >= 250.0lf) {
            id = ore > 0.84lf ? uBlocks[2] : (ore > 0.76lf ? uBlocks[3] : uBlocks[1]);
        } else if (below >= 90.0lf && ore > 0.915lf) {
            id = uBlocks[3];
        } else if (below >= 90.0lf && ore > 0.86lf) {
            id = uBlocks[4];
        } else {
            // Match the C++ lazy order so that ore-laden regions do not evaluate
            // 4 expensive FP64 noises for every single solid voxel.
            double copper = normalized_noise(dvec3(double(wx)*0.13lf+31.7lf, double(wy)*0.13lf-4.2lf, double(wz)*0.13lf+9.9lf));
            uncertain_result = uncertain_result || uncertain(copper, 0.86lf);
            if (copper > 0.86lf) {
                id = uBlocks[5];
            } else if (below >= 90.0lf) {
                double lapis = normalized_noise(dvec3(double(wx)*0.13lf+43.1lf, double(wy)*0.13lf-12.3lf, double(wz)*0.13lf+7.4lf));
                uncertain_result = uncertain_result || uncertain(lapis, 0.88lf);
                if (lapis > 0.88lf) {
                    id = uBlocks[6];
                } else {
                    double coal = normalized_noise(dvec3(double(wx)*0.13lf-17.3lf, double(wy)*0.13lf+12.6lf, double(wz)*0.13lf+5.1lf));
                    uncertain_result = uncertain_result || uncertain(coal, 0.80lf);
                    id = coal > 0.80lf ? uBlocks[7] : ore > 0.74lf ? uBlocks[8] : uBlocks[0];
                }
            } else {
                double coal = normalized_noise(dvec3(double(wx)*0.13lf-17.3lf, double(wy)*0.13lf+12.6lf, double(wz)*0.13lf+5.1lf));
                uncertain_result = uncertain_result || uncertain(coal, 0.80lf);
                if (coal > 0.80lf) id = uBlocks[7];
                else {
                    double lapis = normalized_noise(dvec3(double(wx)*0.13lf+43.1lf, double(wy)*0.13lf-12.3lf, double(wz)*0.13lf+7.4lf));
                    uncertain_result = uncertain_result || uncertain(lapis, 0.92lf);
                    id = lapis > 0.92lf ? uBlocks[6] : ore > 0.82lf ? uBlocks[8] :
                         (ore > 0.70lf && column.biome == 4u) ? uBlocks[9] : uBlocks[0];
                }
            }
        }
        if (uncertain_result) id = 0u;
    }
    return baseMode && id == 0u ? 0xffffu : id;
}

shared uint laneMaterial[64];
void main() {
    // Each full 32^3 level is a multiple of 64. The guard is uniform across
    // the workgroup, so all participating lanes reach the packing barrier.
    uint index = gl_GlobalInvocationID.x;
    if (gl_WorkGroupID.x * 64u >= 32768u * uint(uChunkCount)) return;
    uint lane = gl_LocalInvocationID.x;
    laneMaterial[lane] = materialAt(index);
    barrier();
    if ((lane & 1u) == 0u)
        materials[index >> 1u] = laneMaterial[lane] | (laneMaterial[lane+1u] << 16u);
    // Positive completion certificate: zero is NEVER success. An old shader
    // or incomplete dispatch cannot accidentally certify a level. Only in
    // explicit base-certificate mode; normal material dispatch is unchanged.
    if (uCertify != 0u && lane == 0u) {
        for (uint i = 0u; i < 64u; ++i)
            if (laneMaterial[i] == 0xffffu) return;
        atomicAdd(materials[uint(uChunkCount) * 16384u + index / 32768u], 1u);
    }
}
