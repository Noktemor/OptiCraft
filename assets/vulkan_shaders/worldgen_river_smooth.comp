#version 450
layout(local_size_x=64) in;
layout(push_constant) uniform Params { uint axis; };
layout(std430,binding=1) readonly buffer Height { int height[]; };
layout(std430,binding=2) buffer Horizontal { double horizontal[]; };
layout(std430,binding=3) writeonly buffer Smooth { double smooth_height[]; };
void main(){
 uint i=gl_GlobalInvocationID.x; if(i>=589824u)return;
 int x=int(i%768u),z=int(i/768u);
 precise double sum=0.0;
 if(axis==0u){
   for(int d=-2;d<=2;++d)sum+=double(height[z*768+clamp(x+d,0,767)]);
   horizontal[i]=sum/5.0;
 }else if(axis==1u){
   for(int d=-2;d<=2;++d)sum+=horizontal[clamp(z+d,0,767)*768+x];
   smooth_height[i]=sum/5.0;
 }
}
