#version 450
#extension GL_GOOGLE_include_directive : require
#define MISC_EMIT 1
#include "voxel_misc_common.glsl"
layout(local_size_x=64) in;
void main(){
    uint cell=gl_GlobalInvocationID.x;
    if(cell>=32768u)return;
    uint job=params.firstJob+gl_WorkGroupID.y;
    if(job>=params.jobCount)return;
    uint slot=jobSlots[job];
    if(slot==0xffffffffu)return;
    MiscSlot chunk=slots[slot];
    if((uint(chunk.origin.w)&10u)==8u)return;
    // Fast path writes to an unpublished reservation, not the live slot range.
    if(params.fastCapacity!=0u){
        chunk.source.z=params.fastBase+job*params.fastCapacity;
        chunk.source.w=params.fastCapacity;
    }
    meshCell(job,slot,chunk,cell);
}
