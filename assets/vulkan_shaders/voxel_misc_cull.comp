#version 450
// Identical culling policy to voxel_cull.comp, but the original 96B GpuMiscSlot.
layout(local_size_x=64) in;
struct MiscSlot {
    uvec4 source;
    ivec4 origin;
    ivec4 neighborsA;
    ivec4 neighborsB;
    ivec4 metaNeighborsA;
    ivec4 metaNeighborsB;
};
layout(std430,binding=0) readonly buffer ChunkSlots {MiscSlot slots[];};
layout(std430,binding=1) readonly buffer Draws {uvec4 draws[];};
layout(std430,binding=2) readonly buffer LiveSlots {uint ids[];};
layout(std430,binding=3) buffer Visible {uvec4 result[];};
layout(std430,binding=4) buffer DrawCount {uint drawCount;};
layout(push_constant) uniform Params {vec4 planes[6]; uint firstJob;uint totalJobs;uint compact;uint pad1;vec4 depth;} params;
bool intersects(vec3 lo,vec3 hi){
    for(uint p=0u;p<6u;++p){
        vec3 n=params.planes[p].xyz;
        vec3 vertex=mix(lo,hi,greaterThanEqual(n,vec3(0.0)));
        if(dot(n,vertex)+params.planes[p].w<0.0)return false;
    }
    return true;
}
// Compact and sort up to 2048 inputs per workgroup. Large lists use a
// disjoint scratch suffix followed by an exact rank-based merge.
shared float keys[2048];
shared uint order[2048];
shared uint visibleCount;
const uint INVALID=0xffffffffu;
const uint BLOCK=2048u;
bool before(float a,uint ia,float b,uint ib){
    if(ia==INVALID || ib==INVALID)return ia!=INVALID && ib==INVALID;
    return a>b || (a==b && ia<ib);
}
// Scratch records are (float depth bits, slot ID, unique scratch position, 0).
// The final position is also a deterministic tie breaker for invalid entries.
bool recordBefore(uvec4 a,uvec4 b){
    if(a.y==b.y && (a.y==INVALID || a.x==b.x))return a.z<b.z;
    return before(uintBitsToFloat(a.x),a.y,uintBitsToFloat(b.x),b.y);
}
void mergeBlocks(){
    uint i=gl_GlobalInvocationID.x;
    uint n=params.totalJobs;
    if(i>=n)return;
    uint base=params.firstJob;
    uvec4 item=result[base+i];
    uint own=(i/BLOCK)*BLOCK;
    uint rank=i-own;
    for(uint block=0u;block<n;block+=BLOCK){
        if(block==own)continue;
        uint lo=block,hi=min(block+BLOCK,n);
        // Lower bound in the other sorted run. Every rank is unique, so
        // these global writes are disjoint and never overwrite scratch.
        while(lo<hi){
            uint mid=lo+(hi-lo)/2u;
            if(recordBefore(result[base+mid],item))lo=mid+1u;
            else hi=mid;
        }
        rank+=lo-block;
    }
    result[rank]=item.y==INVALID?uvec4(0u):draws[item.y];
}
void main(){
    if(params.pad1==2u){mergeBlocks();return;}
    uint lane=gl_LocalInvocationID.x;
    uint start=gl_WorkGroupID.x*BLOCK;
    uint n=min(BLOCK,params.totalJobs-start);
    // Compact first: the sort network scales with visible nonempty draws,
    // rather than with all resident slots (including air and culled chunks).
    if(lane==0u)visibleCount=0u;
    barrier();
    for(uint i=lane;i<n;i+=64u){
        uint id=ids[start+i];
        if(id>=uint(slots.length()) || id>=uint(draws.length()) || draws[id].y==0u)continue;
        vec3 lo=vec3(slots[id].origin.xyz);
        // Match the conservative shape bounds of voxel_hiz.comp.
        if(!intersects(lo-vec3(2.0),lo+vec3(34.0)))continue;
        uint index=atomicAdd(visibleCount,1u);
        float key=dot(params.depth.xyz,lo+vec3(16.0));
        keys[index]=isnan(key)?0.0:key;order[index]=id;
    }
    barrier();
    uint valid=visibleCount;
    uint padded=1u;
    while(padded<valid)padded<<=1u;
    for(uint i=valid+lane;i<padded;i+=64u){keys[i]=-3.402823e38;order[i]=INVALID;}
    barrier();
    for(uint width=2u;width<=padded;width<<=1u){
        for(uint stride=width>>1u;stride>0u;stride>>=1u){
            for(uint i=lane;i<padded;i+=64u){
                uint j=i^stride;
                if(j>i){
                    bool descending=(i&width)==0u;
                    bool ab=before(keys[i],order[i],keys[j],order[j]);
                    bool ba=before(keys[j],order[j],keys[i],order[i]);
                    if((descending && ba)||(!descending && ab)){
                        float k=keys[i];uint id=order[i];
                        keys[i]=keys[j];order[i]=order[j];keys[j]=k;order[j]=id;
                    }
                }
            }
            barrier();
        }
    }
    for(uint i=lane;i<n;i+=64u){
        uint slot=i<valid?order[i]:INVALID;
        if(params.pad1==1u){
            uint pos=start+i;
            result[params.firstJob+pos]=uvec4(i<valid?floatBitsToUint(keys[i]):0u,slot,pos,0u);
        }else result[i]=slot==INVALID?uvec4(0u):draws[slot];
    }
}
