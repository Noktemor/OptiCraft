#version 450
// Read a selected column directly from Stage104's batch kinds. Write only
// the active masks of a single material input, using its own ordered Y list.
layout(local_size_x=64) in;
layout(std430,binding=6) readonly buffer Kinds {uint kinds[];};
layout(std430,binding=7) buffer Material {uint words[];};
layout(push_constant) uniform Params {uint column,columns,count;};
void main(){
 uint i=gl_GlobalInvocationID.x,level=gl_WorkGroupID.y;
 if(i>=2048u||count==0u||count>9u||level>=count||columns==0u||columns>8u||column>=columns)return;
 int cy=int(words[level]);if(cy < -3125000 || cy > 3125000)return;
 int y=cy*32+int(i/64u);uint word=0u;
 if(y>=-150 && y<=130){
  uint row=uint(y+150)*64u+i%64u;
  for(uint j=0u;j<16u;++j){
   uint k=(kinds[column*35968u+row*2u+j/8u]>>((j%8u)*4u))&15u;
   // Unexpected kind must force a material fallback, never silently solid.
   uint v=(k==1u||k==3u)?1u:(k==2u||k==4u)?2u:k==0u?0u:3u;
   word|=v<<(2u*j);
  }
 }
 words[4107u+level*2048u+i]=word;
}
