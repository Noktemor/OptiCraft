#version 450
// Normal depth: 0 near, 1 far. Every pyramid cell stores MAX depth,
// including uncovered pixels. Partial tiles at image edges only cover real pixels.
layout(local_size_x=64) in;
layout(binding=0) uniform sampler2D depthImage;
layout(std430,binding=1) buffer Pyramid {float depths[];};
struct ChunkSlot {uvec4 source; ivec4 origin; ivec4 neighborA; ivec4 neighborB;};
layout(std430,binding=2) readonly buffer Chunks {ChunkSlot slots[];};
layout(std430,binding=3) readonly buffer Published {uvec4 draws[];};
layout(std430,binding=4) readonly buffer Live {uint indices[];};
layout(std430,binding=5) writeonly buffer Visible {uvec4 visible[];};
layout(std430,binding=6) buffer Count {uint drawCount;};
layout(std430,binding=7) buffer MiscVisible {uvec4 miscVisible[];};
layout(std430,binding=8) readonly buffer MiscQuads {uvec4 miscQuads[];};
layout(push_constant) uniform Params {
    mat4 vp;
    vec4 eye;
    uvec4 dims; // full width, height, live slots, compact
    uvec4 op; // mode (0 base, 1 reduce, 2 cull), level, first invocation, unused
} pc;
uvec2 baseSize(){return (pc.dims.xy+7u)/8u;}
uvec2 levelSize(uint level){uvec2 s=baseSize();for(uint i=0u;i<level;++i)s=(s+1u)/2u;return s;}
uint levelOffset(uint level){uvec2 s=baseSize();uint off=0u;for(uint i=0u;i<level;++i){off+=s.x*s.y;s=(s+1u)/2u;}return off;}
float atLevel(uint level,uvec2 p){return depths[levelOffset(level)+p.y*levelSize(level).x+p.x];}
void build(uint id){
    uint level=pc.op.y;uvec2 s=levelSize(level);
    if(id>=s.x*s.y)return;
    uvec2 p=uvec2(id%s.x,id/s.x);float d=0.0;
    if(level==0u){
        uvec2 start=p*8u,end=min(start+8u,pc.dims.xy);
        for(uint y=start.y;y<end.y;++y)for(uint x=start.x;x<end.x;++x)
            d=max(d,texelFetch(depthImage,ivec2(x,y),0).r);
    }else{
        uvec2 prev=levelSize(level-1u),start=p*2u,end=min(start+2u,prev);
        for(uint y=start.y;y<end.y;++y)for(uint x=start.x;x<end.x;++x)
            d=max(d,atLevel(level-1u,uvec2(x,y)));
    }
    depths[levelOffset(level)+id]=d;
}
bool hidden(vec3 mn,vec3 mx){
    vec2 lo=vec2(1.0),hi=vec2(-1.0);float nearest=1.0;
    uint outside=63u;bool unsafe=false;
    for(uint i=0u;i<8u;++i){
        vec3 p=mix(mn,mx,bvec3((i&1u)!=0u,(i&2u)!=0u,(i&4u)!=0u));
        vec4 c=pc.vp*vec4(p,1.0);
        uint mask=(c.x < -c.w?1u:0u)|(c.x > c.w?2u:0u)|(c.y < -c.w?4u:0u)|(c.y > c.w?8u:0u)|(c.z < 0.0?16u:0u)|(c.z > c.w?32u:0u);
        outside &= mask;
        if(c.w<=0.0001 || c.z<=0.0 || any(isnan(c)) || any(isinf(c))){unsafe=true;continue;}
        vec3 ndc=c.xyz/c.w;lo=min(lo,ndc.xy);hi=max(hi,ndc.xy);nearest=min(nearest,ndc.z);
    }
    if(outside!=0u && !unsafe)return true;
    if(unsafe)return false; // crossing eye/near plane: always keep
    vec2 extent=vec2(pc.dims.xy);
    // Expand by a pixel on all sides for conservative rounding/raster coverage.
    vec2 pixelLo=clamp(floor((lo*0.5+0.5)*extent)-1.0,vec2(0),extent-1.0);
    vec2 pixelHi=clamp(ceil((hi*0.5+0.5)*extent)+1.0,vec2(0),extent-1.0);
    uvec2 a=uvec2(pixelLo)/8u,b=uvec2(pixelHi)/8u;
    uint level=0u;
    while(any(greaterThan(b-a,uvec2(1u)))){a/=2u;b/=2u;++level;}
    float farthest=0.0;
    for(uint y=a.y;y<=b.y;++y)for(uint x=a.x;x<=b.x;++x)farthest=max(farthest,atLevel(level,uvec2(x,y)));
    // Equality, sky (1.0) and nearly equal depths never occlude.
    return nearest>farthest+0.0001;
}
void main(){
    uint id=pc.op.z+gl_GlobalInvocationID.x;
    if(pc.op.x<2u){build(id);return;}
    if(pc.op.x==3u){
        if(id>=pc.dims.z)return;
        uvec4 raw=miscVisible[id];
        if(raw.y==0u || raw.w>=uint(miscQuads.length())/2u)return;
        uint slot=miscQuads[raw.w*2u].x;
        if(slot>=uint(slots.length()))return;
        vec3 mn=vec3(slots[slot].origin.xyz);
        // Shapes can reach outside their nominal block (fences etc.).
        if(hidden(mn-vec3(2.0),mn+vec3(34.0)))miscVisible[id].y=0u;
        return;
    }
    if(id>=pc.dims.z)return;
    uint slot=indices[id];uvec4 raw=uvec4(0u);
    if(slot<uint(slots.length())&&slot<uint(draws.length())){
        raw=draws[slot];vec3 mn=vec3(slots[slot].origin.xyz);
        if(raw.y!=0u && (all(lessThanEqual(abs(mn+vec3(16.0)-pc.eye.xyz),vec3(96.0)))||hidden(mn,mn+vec3(32.0))))raw.y=0u;
    }
    if(pc.dims.w!=0u){if(raw.y!=0u)visible[atomicAdd(drawCount,1u)]=raw;}
    else visible[id]=raw;
}
