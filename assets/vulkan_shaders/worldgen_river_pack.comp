#version 450
layout(local_size_x=64) in;
layout(push_constant) uniform Params { uint offset_x,offset_z; };
struct Profile { int river,top,water,bed,fall,lake; };
layout(std430,binding=6) readonly buffer Profiles { Profile profiles[]; };
layout(std430,binding=7) buffer Material { uint words[]; };
void main(){
 uint i=gl_GlobalInvocationID.x;if(i>=1024u||offset_x>224u||offset_z>224u||offset_x%32u!=0u||offset_z%32u!=0u)return;
 Profile p=profiles[(offset_z+i/32u)*256u+offset_x+i%32u];
 // 9 reserved level indices + 2 header words, four profile words per column.
 uint j=11u+i*4u;words[j]=p.river!=0?uint(p.bed):2147483647u;words[j+1u]=uint(p.water);words[j+2u]=uint(p.top);
}
